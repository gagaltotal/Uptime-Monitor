# Salin file ini menjadi ".env" di folder yang sama (jangan pernah commit .env
# yang sudah diisi ke Git — file ini hanya contoh/template).
#
#   cp .env.example .env
#
# ============================================================================
# MongoDB
# ============================================================================
MONGO_ROOT_USER=admin
# WAJIB diganti. Contoh membuat password acak:  openssl rand -hex 24
MONGO_ROOT_PASSWORD=ganti_dengan_password_kuat_dan_acak
MONGO_DB_NAME=uptime_monitor

# ============================================================================
# Backend — kunci JWT (WAJIB diganti, masing-masing harus BERBEDA & ACAK)
# ============================================================================
# Cara generate (jalankan dua kali, pakai hasil yang berbeda untuk tiap baris):
#   openssl rand -hex 64
JWT_ACCESS_SECRET=ganti_dengan_hasil_openssl_rand_hex_64_pertama
JWT_REFRESH_SECRET=ganti_dengan_hasil_openssl_rand_hex_64_kedua_yang_berbeda

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Berapa hari histori heartbeat disimpan sebelum dibersihkan otomatis.
HEARTBEAT_RETENTION_DAYS=90

# ============================================================================
# Jaringan / Cookie
# ============================================================================
# Origin persis tempat frontend diakses pengguna (tanpa trailing slash).
# Jika Anda mengakses lewat IP LAN atau domain lain, SESUAIKAN nilai ini,
# atau login/refresh token tidak akan berfungsi.
CORS_ORIGIN=http://localhost:3000

# Set "true" HANYA jika aplikasi sudah diakses lewat HTTPS (misalnya di
# belakang reverse proxy seperti Caddy/Traefik/nginx-proxy-manager dengan
# TLS aktif). Jika masih http:// biasa (mis. akses LAN), biarkan "false".
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ============================================================================
# Port yang dibuka ke host
# ============================================================================
# Port di mesin Anda tempat dashboard bisa diakses, mis. http://localhost:3000
FRONTEND_PORT=3000
