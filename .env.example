# Salin file ini menjadi ".env" di folder yang sama (jangan pernah commit .env
# yang sudah diisi ke Git — file ini hanya contoh/template).
#
#   cp .env.example .env
#
# ============================================================================
# MongoDB
# ============================================================================
MONGO_ROOT_USER=admin
# WAJIB diganti. Contoh membuat password acak:  openssl rand -hex 24
MONGO_ROOT_PASSWORD=ganti_dengan_password_kuat_dan_acak
MONGO_DB_NAME=uptime_monitor

# ============================================================================
# Backend — kunci JWT (WAJIB diganti, masing-masing harus BERBEDA & ACAK)
# ============================================================================
# Cara generate (jalankan dua kali, pakai hasil yang berbeda untuk tiap baris):
#   openssl rand -hex 64
JWT_ACCESS_SECRET=ganti_dengan_hasil_openssl_rand_hex_64_pertama
JWT_REFRESH_SECRET=ganti_dengan_hasil_openssl_rand_hex_64_kedua_yang_berbeda

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Berapa hari histori heartbeat disimpan sebelum dibersihkan otomatis.
HEARTBEAT_RETENTION_DAYS=90

# ============================================================================
# SSL & Domain Monitoring
# ============================================================================
# Seberapa sering engine SSL memeriksa jadwal pengecekan (dalam milidetik).
SSL_TICK_INTERVAL_MS=30000
# Ambang hari peringatan default untuk monitor SSL baru (notifikasi dikirim
# saat sisa hari <= nilai ini). Nilai ini bisa ditimpa per monitor di UI.
SSL_WARN_THRESHOLD_DAYS=14
# Jeda minimal (jam) antar notifikasi berulang untuk insiden SSL yang sama,
# agar kanal notifikasi tidak dibanjiri pesan. Notifikasi tetap dikirim segera
# saat status berubah (edge), jeda ini hanya untuk pengulangan.
SSL_RENOTIFY_INTERVAL_HOURS=24

# ============================================================================
# Migrasi database
# ============================================================================
# Jalankan migrasi otomatis setiap kali backend start. Migrasi bersifat
# idempoten (aman dijalankan berulang), jadi biarkan "true" kecuali Anda
# ingin menjalankannya manual dengan: docker compose exec backend npm run migrate
AUTO_MIGRATE=true

# ============================================================================
# Seeder akun admin (OPSIONAL)
# ============================================================================
# Jika SEED_ADMIN_EMAIL DIKOSONGKAN, aplikasi akan memakai alur normal:
# halaman /setup di browser untuk membuat admin pertama secara interaktif.
# (Variabel SEED_ADMIN_* lainnya juga otomatis diabaikan bila email kosong.)
#
# Isi SEED_ADMIN_EMAIL jika Anda ingin akun admin dibuat otomatis saat backend
# pertama kali dijalankan (berguna untuk deployment otomatis/CI).
# SEED_ADMIN_EMAIL=admin@contoh.com
# SEED_ADMIN_NAME=Administrator

# Kosongkan SEED_ADMIN_PASSWORD agar sistem MEMBUAT kata sandi acak yang kuat
# dan menampilkannya SEKALI di log (lihat: docker compose logs backend).
# Ini pilihan paling aman — tidak ada kata sandi default yang tertulis di file.
#
# Jika ingin menentukan sendiri, WAJIB kuat: minimal 8 karakter dan bukan kata
# sandi umum (admin123, password, dll. akan ditolak saat startup).
# SEED_ADMIN_PASSWORD=

# Role akun yang di-seed: "superadmin" atau "admin". Hanya menerima salah satu
# dari dua nilai itu — nilai lain akan menghentikan startup dengan pesan jelas.
#
#   Kosong (default)      → akun BARU dibuat sebagai superadmin, dan akun yang
#                           sudah ada tidak disentuh sama sekali (role-nya
#                           dipertahankan). Aman untuk restart biasa.
#   SEED_ADMIN_ROLE=superadmin
#                         → selain itu, role akun yang SUDAH ADA juga dipaksa
#                           menjadi superadmin. Kata sandinya TIDAK diubah.
#
# Gunakan ini sekali bila Anda sudah terlanjur deploy sebelum fitur role ada,
# sehingga akun admin lama tersimpan sebagai "admin" dan menu Pengguna tidak
# muncul. Setelah selesai, kosongkan lagi agar restart berikutnya tidak ikut
# mengubah role apa pun.
# SEED_ADMIN_ROLE=superadmin

# ============================================================================
# Jaringan / Cookie
# ============================================================================
# Origin persis tempat frontend diakses pengguna (tanpa trailing slash).
# Jika Anda mengakses lewat IP LAN atau domain lain, SESUAIKAN nilai ini,
# atau login/refresh token tidak akan berfungsi.
CORS_ORIGIN=http://localhost:3000

# Set "true" HANYA jika aplikasi sudah diakses lewat HTTPS (misalnya di
# belakang reverse proxy seperti Caddy/Traefik/nginx-proxy-manager dengan
# TLS aktif). Jika masih http:// biasa (mis. akses LAN), biarkan "false".
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ============================================================================
# Port yang dibuka ke host
# ============================================================================
# Port di mesin Anda tempat dashboard bisa diakses, mis. http://localhost:3000
FRONTEND_PORT=3000
