{
  "name": "uptime-monitor-backend",
  "version": "1.0.0",
  "description": "Self-hosted server & website uptime monitoring API",
  "main": "src/server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "migrate": "node src/cli/migrate.js up",
    "migrate:status": "node src/cli/migrate.js status",
    "migrate:down": "node src/cli/migrate.js down",
    "seed": "node src/cli/seed.js admin",
    "seed:force": "node src/cli/seed.js admin --force",
    "test": "node tests/migrations.test.js && node tests/seeder.test.js",
    "lint:check": "node -e \"console.log('ok')\""
  },
  "dependencies": {
    "express": "^4.21.2",
    "mongoose": "^8.9.5",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "joi": "^17.13.3",
    "helmet": "^8.0.0",
    "cors": "^2.8.5",
    "express-rate-limit": "^7.5.0",
    "express-mongo-sanitize": "^2.2.0",
    "hpp": "^0.2.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "socket.io": "^4.8.1",
    "axios": "^1.7.9",
    "ping": "^0.4.4",
    "morgan": "^1.10.0",
    "compression": "^1.7.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}
